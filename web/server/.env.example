# Copy this file to .env and fill in real values — it's picked up automatically by
# `npm run dev` / `npm run start` (Node's --env-file-if-exists flag, no extra tooling
# required). Never commit a real .env; it's gitignored.
#
# If you use 1Password or another secrets manager instead, that's fine too — anything that
# sets these as real process env vars before `npm run dev` starts works (e.g.
# `op run --env-file=<path> -- npm run dev`); a plain .env file is just the zero-dependency
# default. If wrapping the launch command isn't an option (an IDE run config, etc.), keep a
# separate template with `op://vault/item/field` values in DATABRICKS_HOST/DATABRICKS_TOKEN
# and resolve it into this file with `op inject -i <template> -o .env` instead — re-run that
# whenever the token rotates, since it writes real values to disk once rather than resolving
# them at launch each time.
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=dapi...
# Required — every workspace has a different Genie space id, so there's no default. Find it
# via `databricks bundle summary` if this space was deployed by this project's bundle
# (`databricks genie list-spaces` does not show bundle-deployed spaces), or from the space's
# "About" tab in the Databricks UI.
GENIE_SPACE_ID=<your-genie-space-id>
PORT=3000
# Comma-separated browser origins allowed to call this proxy.
ALLOWED_ORIGINS=http://localhost:5173
# Questions per minute the proxy will forward. Databricks caps the API at 5/min per workspace.
QUESTIONS_PER_MINUTE=4
# Deployed Databricks App URL (see ../../app/), shown as the "Try it" link on the App row of
# the Compare tab. Get it from `databricks apps get <app-name> -o json` (.url). Leave unset
# if there's no App deployed yet — the Compare tab disables that row's link instead.
APP_URL=
# Workspace id, used to build the Genie room URL for the Embed tab's iframe (`?w=<id>`).
# Optional — the room URL still works without it. Find it via `databricks current-user me`
# or the workspace URL's own `o=` query param.
DATABRICKS_WORKSPACE_ID=
