# Copy to .env (gitignored) and fill in real values. Both bundles (root and app/) read
# these same BUNDLE_VAR_* names from the process env.
#
# The CLI does not read .env itself. Load it for CLI commands with:
#   set -a; . ./.env; set +a
# or, with a 1Password template instead of a plain file:
#   op run --env-file=<template> -- databricks bundle deploy
# (`dbx <cmd>` in this repo's docs means `databricks <cmd>` with your auth applied.)

# SQL warehouse ID: `dbx warehouses list`
BUNDLE_VAR_warehouse_id=
# Genie space ID: `dbx bundle summary`, or the space's About tab in the UI
BUNDLE_VAR_genie_space_id=
